# Copy to .env.local and fill in. Never commit .env.local.
#
# Both values are server-only. Read them only from server code such as route handlers.
# Do not prefix them with NEXT_PUBLIC_, and never send them to the browser or the extension.

# Supabase project URL: Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co

# Secret key (sb_secret_...) or the legacy service_role key. Bypasses Row Level Security.
SUPABASE_SECRET_KEY=replace-with-your-server-secret-key
